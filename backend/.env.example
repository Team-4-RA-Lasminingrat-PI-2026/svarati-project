DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

GEMINI_API_KEY=PASTE_API_KEY_DARI_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Embedding e5 (kolom embedding). Dipakai bila EMBEDDING_BACKEND tidak diisi "gemini".
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Pilih backend embedding: sentence-transformers (default, e5) atau gemini
EMBEDDING_BACKEND=sentence-transformers

# Retrieval (nilai awal; kalibrasi dengan: python scripts/calibrate.py)
KANDIDAT=20
TOP_K=4
MAX_PER_ENTRY=2
MIN_SIM=0.78
TOPIC_BOOST=0.02
TYPE_BOOST=0.01
REQUIRE_VERIFIED=false

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
INDEKS_PENJELASAN=false

# Percakapan
STORE_CHAT=true
SESSION_TTL_DAYS=30
MAX_MESSAGE_CHARS=4000

# Server
# Kunci bersama Next.js <-> FastAPI (opsional di localhost; wajib jika backend dapat dijangkau lewat jaringan).
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nilai yang sama diisi di .env.local project Next.js sebagai BACKEND_API_KEY.
BACKEND_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false
